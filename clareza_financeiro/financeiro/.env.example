# Modelo das variáveis de ambiente. Copie para .env e substitua as chaves e senhas antes de iniciar.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-outra-senha
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: crie seu bot com @BotFather. Nunca compartilhe o token real.
TELEGRAM_BOT_TOKEN=
# Nome do bot sem @, por exemplo clareza_pessoal_bot.
TELEGRAM_BOT_USERNAME=
